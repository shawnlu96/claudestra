DISCORD_BOT_TOKEN=your-bot-token
DISCORD_GUILD_ID=your-server-id

# Comma-separated Discord user IDs allowed to drive your agents. 17-20 digits each
# (Discord → Settings → Advanced → Developer Mode, then right-click your avatar →
# Copy User ID). This gate is FAIL-CLOSED: leave it empty and every Discord message
# is rejected, not admitted. Placeholders are rejected too — it must be real digits.
ALLOWED_USER_IDS=

BRIDGE_PORT=3847
CONTROL_CHANNEL_ID=your-control-channel-id
USER_NAME=Your Name
MCP_NAME=claudestra

# Optional overrides (leave commented — sensible defaults apply):
# BRIDGE_URL=ws://localhost:3847       # channel-server target; auto-derived from BRIDGE_PORT
# MASTER_DIR=/absolute/path/to/master  # master agent's cwd; defaults to <repo>/master

# Web client: the bridge serves the static Next export itself (no separate web service, no login password —
# browsers pair with `claudestra pair`). `bun run setup` writes this when you pick the Web frontend; the path must be
# absolute and point at `web/out` (`cd web && npm run build`). Unset = the bridge serves only its API.
# BRIDGE_STATIC_DIR=/absolute/path/to/claudestra/web/out

# Relay: connect this machine to a Claudestra relay (docs/relay/protocol.md) so phones / browsers can open
# https://<RELAY_NAME>.<relay host> and peers can reach you — no Tailscale, no open ports. Setting RELAY_URL enables it.
# `bun run setup`'s "Phone access" step writes these for you (default: the official relay wss://relay.sunstriker.cc;
# self-hosters point RELAY_URL at their own). RELAY_NAME is the subdomain label (lowercase letters, digits, dashes;
# default: this machine's hostname). Then `claudestra pair` prints a QR code / link / 8-char code for the phone.
# RELAY_URL=wss://relay.sunstriker.cc
# RELAY_NAME=mini

# Runtime-mutable toggles (managed via `bun src/manager.ts auto-update ...` → ~/.claude-orchestrator/config.json,
# NOT this file):
#   - Claudestra self-update    (default on, 30-min poll)
#   - Claude Code CLI update    (default on, weekly poll)
