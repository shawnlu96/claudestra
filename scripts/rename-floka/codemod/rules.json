{
  "format": "claudestra.rename-codemod-rules",
  "version": 1,
  "from": "Claudestra",
  "to": "Floka",
  "switch": { "key": "rename.codemod", "values": ["off", "observe", "on"], "default": "observe" },
  "roots": ["[Cc]laudestra", "CLAUDESTRA", "cstra", "claude-orchestrator"],
  "rules": [
    { "id": "history.transcripts", "class": "history", "files": ["**/*.jsonl", "**/transcripts/**", "**/archive/**"],
      "reason": "历史 transcript / 会话归档：记录当时发生了什么，旧名是事实，永不替换" },
    { "id": "history.records", "class": "history", "files": ["legacy/**", "ledger/**", "docs/tasks/**", "**/CHANGELOG*"],
      "reason": "退役代码、账本审查记录、已结任务文档、变更日志：历史文本" },
    { "id": "history.migration-tooling", "class": "history",
      "files": ["docs/migrations/floka.md", "scripts/rename-floka/**", "tests/floka-inventory.test.ts", "tests/floka-codemod.test.ts"],
      "reason": "迁移说明、清单、清点与改名脚本自己：必须写旧名才能描述迁移" },
    { "id": "history.license", "class": "history", "files": ["LICENSE"], "reason": "许可证里的版权署名按法律文本保留" },
    { "id": "history.github-refs", "class": "history",
      "match": "github\\.com/shawnlu96/claudestra/(?:pull|issues|commit|releases)/[\\w./-]*",
      "reason": "指向旧仓库地址下既有 PR / issue / 提交的链接：GitHub 改名后自动跳转，不改写" },
    { "id": "history.former-name", "class": "history", "match": "(?:原名|曾用名|formerly|previously) ?Claudestra",
      "reason": "「原名 Claudestra」注记：有意保留的旧品牌" },

    { "id": "protocol.identity-files", "class": "protocol",
      "files": ["**/peers.json", "**/identity.json", "**/instance-key*.json", "**/registry.json"],
      "reason": "身份、peer URL / slug、agent 登记：各实例的数据，值由对端和历史决定" },
    { "id": "protocol.env", "class": "protocol", "match": "CLAUDESTRA_[A-Z0-9_]*",
      "reason": "环境变量：launchd plist、shell profile、子进程之间的约定，改名要新旧双读一段时间" },
    { "id": "protocol.sign-and-wire-labels", "class": "protocol",
      "match": "(?:claudestra|cstra)-[a-z0-9-]+-v\\d+(?![\\w-])|claudestra-relay\\.v\\d+|_claudestra/[a-z]+|_meta\\.claudestra|claudestra:[a-z]+|claudestra-meta",
      "reason": "签名用途串、子协议与扩展标签：进了签名或握手，改了旧版本验不过，要双认" },
    { "id": "protocol.http-headers", "class": "protocol", "match": "(?<![/\\w])[Xx]-(?:[Cc]laudestra|cstra)-[A-Za-z-]+",
      "reason": "HTTP 头：对端和旧客户端还在发旧头" },
    { "id": "protocol.mcp-tool-prefix", "class": "protocol", "match": "mcp__claudestra\\w*",
      "reason": "MCP 工具前缀：写在权限名单、会话记录和 agent 指令里" },
    { "id": "protocol.reverse-dns", "class": "protocol", "match": "(?:com|ai|io)\\.claudestra[\\w.-]*",
      "reason": "launchd label、bundle id：系统里已经登记的名字，要迁移步骤" },
    { "id": "protocol.state-and-checkout", "class": "protocol", "match": "\\.?claude-orchestrator[\\w./-]*",
      "reason": "状态目录、运行时目录、检出目录名与项目 id：磁盘和账本里的既有标识" },
    { "id": "protocol.storage-and-cookies", "class": "protocol", "match": "cstra_[A-Za-z0-9_]+",
      "reason": "cookie、localStorage / IndexedDB 键：浏览器里已经存着旧键，要读旧写新" },
    { "id": "protocol.network-addresses", "class": "protocol", "match": "[A-Za-z][A-Za-z0-9+.-]*:\\\\?/\\\\?/[^\\s\"'`<>]+",
      "reason": "网络地址与 URL scheme：部署出去的域名、中继路径、深链，换了是部署迁移" },
    { "id": "protocol.identities", "class": "protocol",
      "match": "agent-[Cc]laudestra[\\w-]*|peer:[Cc]laudestra[\\w.]*|[\\w.-]+@[Cc]laudestra\\w*|[Cc]laudestra@[\\w-]+",
      "reason": "agent 名、peer 句柄：是身份不是品牌字样，改了就是换了一个身份" },
    { "id": "protocol.install-paths", "class": "protocol",
      "match": "(?:\\.local/bin|\\.bun/bin)/claudestra(?![\\w-])|/opt/claudestra|vendor/claudestra|\\.claudestra-[a-z.]+|\\.bak-claudestra|/Claudestra\\.app",
      "reason": "装到仓库外面的副本的路径：由安装步骤迁移" },

    { "id": "brand.display-docs", "class": "brand",
      "files": ["README.md", "README.zh-CN.md", "SETUP.md", "SETUP.zh-CN.md", "docs/**/*.md"],
      "positions": ["text"], "match": "(?<![\\w@/.:#-])Claudestra(?![\\w@/:-]|\\.\\w)", "replace": { "Claudestra": "Floka" },
      "reason": "文档正文里独立成词的产品名" },
    { "id": "brand.display-comments", "class": "brand",
      "files": ["src/**/*.ts", "web/**/*.ts", "web/**/*.tsx", "tests/**/*.ts", "scripts/**/*.ts"],
      "positions": ["comment"], "match": "(?<![\\w@/.:#-])Claudestra(?![\\w@/:-]|\\.\\w)", "replace": { "Claudestra": "Floka" },
      "reason": "代码注释里独立成词的产品名：不进产物" },
    { "id": "brand.display-jsx-text", "class": "brand", "files": ["web/**/*.tsx"],
      "positions": ["jsx-text"], "match": "(?<![\\w@/.:#-])Claudestra(?![\\w@/:-]|\\.\\w)", "replace": { "Claudestra": "Floka" },
      "reason": "界面上直接显示的产品名（JSX 文本）" }
  ]
}
