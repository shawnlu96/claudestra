{
  "format": "floka.compat-allowlist",
  "version": 1,
  "entries": [
    { "id": "send.peer-signature", "item": "legacy-send", "files": ["src/lib/floka-peer/send.ts"], "match": "claudestra",
      "reason": "对端未钉新族时仍按旧族签出站请求；全部切新发送且旧发送计数归零后可收" },
    { "id": "send.relay-canonical", "item": "legacy-send", "files": ["src/lib/floka-compat/relay/families.ts"], "match": "CANONICAL_FAMILY",
      "reason": "中继缺省发送族仍是 legacy" },
    { "id": "alias.cli-bin", "item": "install-alias", "files": ["src/lib/floka-services/install/production.ts"], "match": "\"claudestra\", \"floka\"",
      "reason": "安装时并排放 claudestra / floka 两个可执行名；旧 MCP 会话与外部安装副本清零后收旧名" },
    { "id": "alias.runtime-dir", "item": "install-alias", "files": ["src/lib/floka-migration/runtime/alias.ts"], "match": "alias",
      "reason": "运行时目录旧路径的别名链接" },
    { "id": "alias.mcp-server", "item": "install-alias", "files": ["src/lib/floka-mcp/families.ts"], "match": "LEGACY_FAMILY",
      "reason": "旧 MCP 服务名 claudestra：还挂着旧名的会话靠它重连" },
    { "id": "receive.signature", "item": "receive-signature",
      "files": ["src/lib/floka-compat/signature/families.ts", "src/lib/floka-compat/signature/request.ts"], "match": "claudestra",
      "reason": "旧签名用途串与旧请求签名头的接收；未过期邀请、能力证明仍在用" },
    { "id": "receive.relay", "item": "receive-relay", "files": ["src/lib/floka-compat/relay/handshake.ts"], "match": "\"legacy\"",
      "reason": "中继握手认旧族子协议；中心侧观察到位前不能收" },
    { "id": "receive.ledger", "item": "receive-ledger", "files": ["src/lib/floka-ledger/uses.ts"], "match": "claudestra",
      "reason": "共享台账、出借回执、审查票据认旧族签名；票据无过期字段，只能实测存活为 0" },
    { "id": "receive.e2e", "item": "receive-e2e", "files": ["src/lib/floka-compat/e2e/exchange.ts"], "match": "claudestra",
      "reason": "E2E 交换认旧族标签" },
    { "id": "receive.browser", "item": "receive-browser", "files": ["src/lib/floka-browser-protocol/credentials.ts"], "match": "claudestra",
      "reason": "设备凭据 cookie / CSRF 头认旧族名" },
    { "id": "browser.storage-cookie", "item": "browser-storage", "files": ["src/lib/floka-browser-protocol/names.ts"], "match": "cstra_",
      "reason": "浏览器里已存的 cstra_ cookie 与 localStorage 键：读旧写新，离线浏览器回来前不能收" },
    { "id": "scheme.app-web", "item": "scheme", "files": ["src/lib/floka-browser-protocol/names.ts"], "match": "web\\+claudestra",
      "reason": "邀请落地页的 claudestra:// 与 web+claudestra 链接 scheme" },
    { "id": "env.legacy-prefix", "item": "env", "files": ["src/lib/floka-env/read.ts"], "match": "LEGACY_PREFIX",
      "reason": "CLAUDESTRA_* 环境变量双读；launchd / systemd 单元与旧会话都换完才能收" },
    { "id": "read.config-autoupdate", "item": "legacy-read", "files": ["src/lib/floka-config/store.ts"], "match": "claudestra",
      "reason": "配置里旧键的读取；旧读兼容可以长期保留，不为旧名归零提前收" },
    { "id": "read.state-layout", "item": "legacy-read", "files": ["src/lib/floka-migration/state/layout.ts"], "match": "\"legacy\"",
      "reason": "旧状态目录布局的识别；只读，不删目录数据" }
  ],
  "retired": [],
  "retain": [
    { "id": "retain.identity",
      "protects": ["**/instance-id*", "**/instance-key*", "**/identity.json", "**/peers.json", "**/peers/**", "**/tokens*", "**/token*.json",
        "**/pins*", "**/pin*.json", "**/revocations*", "**/revoked*"],
      "reason": "实例身份、密钥、peer、token、pin、撤销记录：永不因收兼容删除或改写" },
    { "id": "retain.history", "protects": ["**/*.jsonl", "**/transcripts/**", "**/archive/**"],
      "reason": "历史 transcript 与会话归档：旧名是事实，永不改写" }
  ]
}
