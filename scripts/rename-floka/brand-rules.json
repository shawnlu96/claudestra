{
  "format": "claudestra.rename-brand-overlay",
  "version": 1,
  "base": "codemod/rules.json",
  "note": "BRAND1 的允许表 = codemod 自带表里全部 history / protocol 规则（原样，也是换表松不掉的保护）+ 下面这些。自带的三条 brand 规则不用：它们覆盖 src / tests，不在本卡精准例外范围里。brand 规则只认本卡范围里的文件；范围外和本卡不改的旧名都归 history / protocol，列进计划的 kept / manual。",
  "rules": [
    { "id": "brand1.history.migration-tests", "class": "history", "files": ["tests/floka-brand*.test.ts"],
      "reason": "本卡自己的测试：必须写旧名才能断言迁移" },
    { "id": "brand1.protocol.native-identity", "class": "protocol",
      "files": ["desktop/src-tauri/Info.plist", "desktop/src-tauri/tauri.conf.json", "desktop/src-tauri/Cargo.toml", "desktop/src-tauri/Cargo.lock",
        "native/capacitor.config.ts", "native/ios/App/App.xcodeproj/project.pbxproj", "native/ios/App/App/AppDelegate.swift", "native/ios/App/App/Info.plist"],
      "reason": "App 身份文件（bundle id、productName、显示名、crate / 二进制名）：NATIVE1 在做新 App 身份，改了就是换一个 App，不按文本替换" },
    { "id": "brand1.protocol.out-of-range", "class": "protocol",
      "files": ["src/**", "tests/**", "scripts/**", "deploy/**", "skills/**", ".env.example", "bunfig.toml"],
      "reason": "BRAND1 精准例外范围外：代码、测试、脚本、部署文件里的旧名由各协议卡兼容；其中的展示文字留给后续卡（identifiers.json 里 card 标「未覆盖」的项），本卡不改" },
    { "id": "brand1.protocol.lowercase", "class": "protocol",
      "match": "[\\w./+@:~-]*(?<!\"name\": \")claudestra[\\w./:+-]*",
      "reason": "小写 claudestra：CLI 命令名、仓库 slug、检出目录名、MCP 名、配置键、包内路径。floka 命令受 rename.cli 管控、默认不装，文档命令保持现行的 claudestra；其余是协议或路径。package.json 系列的 name 字段除外，见 brand1.package-names" },
    { "id": "brand1.protocol.short-internal", "class": "protocol",
      "match": "[\\w.#:+/-]*cstra[\\w.:+-]*",
      "reason": "cstra 短前缀（CSS 类 / 变量、data-* 属性、window.__cstra*、cstra: 事件、存储键）：进程内名字或持久化名字，改名要和 tests/ 里的断言成组改（identifiers.json 的 brand.short-* 与 browser.*），本卡不碰" },
    { "id": "brand1.protocol.symbols", "class": "protocol",
      "match": "[\\w$.]*\\w[Cc]laudestra[\\w$]*|[Cc]laudestra[A-Z_$][\\w$]*|__claudestra\\w*",
      "reason": "代码符号里的旧名（ClaudestraViewController、installClaudestraCli、__claudestraNav…）：编译期符号，和定义处、测试成组改（identifiers.json 的 brand.symbols），本卡不碰" },
    { "id": "brand1.protocol.app-artifacts", "class": "protocol",
      "match": "[\\w/.-]*Claudestra(?:\\.app|_)[\\w.-]*",
      "reason": "App 包与 dmg 产物名：由 productName 决定，随 NATIVE1 的新 App 身份一起改" },

    { "id": "brand1.protocol.emitted-text", "class": "protocol",
      "match": "\\[Claudestra 调度器|[「“]Claudestra · (?:类型|type)[」”]|(?:设置|Settings) → Claudestra →|标题「Claudestra」|显示名改成「Claudestra」",
      "reason": "引用别处原样发出的文字：调度器消息首行、通知「不带正文」的标题（src 发出，本卡不改 src）、iOS 设置里的 App 显示名（NATIVE1）、已发生的操作记录。改了说明就和实际看到的对不上" },

    { "id": "brand1.display-docs", "class": "brand",
      "files": ["README.md", "README.zh-CN.md", "SETUP.md", "SETUP.zh-CN.md", "CLAUDE.md", "CLAUDE.zh-CN.md", "docs/**/*.md", ".claude/**/*.md",
        "roles/*.md", "web/**/*.md", "desktop/**/*.md", "native/**/*.md"],
      "positions": ["text"], "match": "(?<![\\w@/.:#-])Claudestra(?![\\w@/:-]|\\.\\w)|(?<=Cross-)Claudestra(?![\\w@/:-]|\\.\\w)", "replace": { "Claudestra": "Floka" },
      "reason": "文档正文里独立成词的产品名（含 Cross-Claudestra）" },
    { "id": "brand1.display-code-text", "class": "brand",
      "files": ["web/**/*.ts", "web/**/*.tsx", "web/**/*.js", "web/**/*.mjs", "desktop/**/*.ts", "desktop/**/*.js", "native/**/*.ts"],
      "positions": ["comment", "string", "jsx-text"],
      "match": "(?<![\\w@/.:#-])Claudestra(?![\\w@/:-]|\\.\\w)|(?<![\\w@/.:#-])Claudestra(?=:\\\\n)|(?<![\\w@/.:#-])CLAUDESTRA(?![\\w@/:-])", "replace": { "Claudestra": "Floka", "CLAUDESTRA": "FLOKA" },
      "reason": "web / desktop / native 前端代码里注释、字符串、JSX 文本中独立成词的产品名：界面文案与说明" },
    { "id": "brand1.display-data", "class": "brand",
      "files": ["install.sh", "master/**", "web/.env.example", "web/**/*.css", "web/**/*.html", "web/public/**/*.json", "desktop/**/*.rs", "desktop/**/*.html", "desktop/**/*.sh",
        "desktop/**/*.command", "native/**/*.swift", "native/**/*.html", "native/**/*.sh"],
      "positions": ["data", "text"], "match": "(?<![\\w@/.:#-])Claudestra(?![\\w@/:-]|\\.\\w)", "replace": { "Claudestra": "Floka" },
      "reason": "安装脚本提示、master 指令模板、样式 / 页面 / Rust / Swift 里独立成词的产品名（App 身份文件除外，见 brand1.protocol.native-identity）" },
    { "id": "brand1.package-names", "class": "brand",
      "files": ["package.json", "web/package.json", "native/package.json", "desktop/package.json", "web/package-lock.json", "web/bun.lock", "desktop/bun.lock"],
      "positions": ["data"], "match": "(?<=\"name\": \")claudestra(?=(?:-web|-native|-desktop)?\")", "replace": { "claudestra": "floka" },
      "reason": "package 发布名：claudestra / claudestra-web / -native / -desktop → floka / floka-*，锁文件里的工作区名同步" },
    { "id": "brand1.package-descriptions", "class": "brand",
      "files": ["package.json", "web/package.json", "native/package.json", "desktop/package.json"],
      "positions": ["data"], "match": "(?<=\"description\": \")Claudestra(?![\\w@/:-]|\\.\\w)", "replace": { "Claudestra": "Floka" },
      "reason": "package 描述开头的产品名" }
  ]
}
