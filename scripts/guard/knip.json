{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/{bridge,manager,channel-server,launcher,cron,setup,relay,discord-reply,html2png,ansi2html,acp-host}.ts",
    "scripts/acp-stub.ts",
    "scripts/codex-probe.ts",
