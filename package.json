{
  "name": "claudestra",
  "version": "2.33.0",
  "description": "Run your coding agents — Claude Code and Pi — on your workstation and drive them from your phone: a self-hosted PWA web client (Discord optional), every session in tmux.",
  "type": "module",
  "scripts": {
    "bridge": "bun run src/bridge.ts",
    "scheduler": "bun run src/scheduler.ts",
    "manager": "bun run src/manager.ts",
    "sandbox": "bun scripts/sandbox.ts",
    "setup": "bun run src/setup.ts",
    "desktop-cli": "bun run src/desktop-cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test && bun run guard",
    "guard": "bun scripts/guard/index.ts",
    "guard:update": "bun scripts/guard/index.ts --update"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "discord.js": "^14.18.0",
    "playwright-core": "^1.58.2",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@types/bun": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "knip": "6.37.0",
    "oxc-parser": "0.150.0",
    "typescript": "^7.0.2"
  }
}
